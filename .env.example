# ==============================================================================
# AI-DOCTOR Platform - Environment Configuration Reference
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Database Connection (MongoDB Mongoose)
MONGODB_URI=mongodb://127.0.0.1:27017/aidoctor

# Authentication Security (Cryptographic JWT Secret)
JWT_SECRET=replace_with_a_secure_long_random_hex_string_for_jwt_signing

# Cross-Origin Resource Sharing (CORS) Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Artificial Intelligence Engine (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery / Two-Factor OTP System (Nodemailer SMTP)
EMAIL_USER=your_email_address@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Rate Limiting Override (Set to 'true' only in automated test pipelines)
DISABLE_RATE_LIMITING=false
